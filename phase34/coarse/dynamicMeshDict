FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}

dynamicFvMesh   dynamicMotionSolverFvMesh;
motionSolverLibs (fvMotionSolvers);
motionSolver    solidBody;
solidBodyMotionFunction tabulated6DoFMotion;   // no cellZone: every point moves
CofG            (0 1 0.05);                    // pivot at its t = 0 position (heave = +H0)
timeDataFileName "$FOAM_CASE/constant/motion.dat";
