FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    cellDisplacement { solver PCG; preconditioner DIC; tolerance 1e-06; relTol 0; maxIter 100; }
    p     { solver PBiCGStab; preconditioner DILU; tolerance 1e-8; relTol 0.01; }   // overset matrices are asymmetric
    pFinal { $p; relTol 0; }
    pcorr  { $pFinal; }
    pcorrFinal { $pcorr; }
    U      { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-8; relTol 0.1; }
    UFinal { $U; relTol 0; }
}
PIMPLE
{
    momentumPredictor   true;
    correctPhi          false;
    oversetAdjustPhi    true;
    nOuterCorrectors    2;
    nCorrectors         2;
    nNonOrthogonalCorrectors 0;
    ddtCorr             true;
}
relaxationFactors { equations { ".*" 1; } }
