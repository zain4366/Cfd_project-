FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// Overset flapping foil: Kinsey & Dumas (2008) Case I. Times in c/U; endTime/deltaT are set by the scripts.
application     overPimpleDyMFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime    14.285714285714285;      // one period T = 1/f*
deltaT    0.0035714285714285713;  // T/2000
writeControl    adjustableRunTime;
writeInterval    1.7857142857142856;
purgeWrite      0;
writeFormat     ascii;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable false;
libs            (overset fvMotionSolvers);

adjustTimeStep  no;           // fixed time step, as in Kinsey & Dumas

OptimisationSwitches
{
    stopAtWriteNowSignal 12;  // SIGUSR2 = write the current time and stop (used before the 6-hour job limit)
}

functions
{
    forces
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        patches         (foil);
        rho             rhoInf;
        rhoInf          1;
        CofR            (0 0 0);  // moment about the origin; post-processing moves it to the moving pivot
        log             false;
    }
    courant
    {
        type            CourantNo;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }
}
